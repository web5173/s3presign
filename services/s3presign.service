[Unit]
Description = s3presign

[Service]
Type             = simple
User             = root
Group            = root
LimitNOFILE      = 4096
Restart          = always
RestartSec       = 5s
StandardOutput   = append:/root/s3/std.log
StandardError    = append:/root/s3/std.log
WorkingDirectory = /root/s3
ExecStart        = /root/s3/s3presign

[Install]
WantedBy = multi-user.target